rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ph-0-us-6 / ph-9-us-2: the user's own profile doc. Fields:
    //   createdAt   timestamp, set once by AuthProvider on first launch
    //   onboarding  { choice: 'baseline' | 'learn', completedAt: server timestamp }
    //   testDate    'YYYY-MM-DD' string, or null when cleared
    // The owner may create it with only createdAt, and afterwards change only onboarding and
    // testDate. Delete is denied: account deletion goes through a Cloud Function (ph-9-us-9).
    // The date regex checks format only; the client validates real calendar dates.
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validOnboarding(o) {
        return o is map
          && o.keys().hasOnly(['choice', 'completedAt'])
          && o.keys().hasAll(['choice', 'completedAt'])
          && o.choice in ['baseline', 'learn']
          && o.completedAt == request.time;
      }
      function validTestDate(d) {
        return d == null
          || (d is string && d.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$'));
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['createdAt'])
        && request.resource.data.createdAt == request.time;
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onboarding', 'testDate'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['onboarding'])
          || validOnboarding(request.resource.data.onboarding))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['testDate'])
          || validTestDate(request.resource.data.testDate));
      allow delete: if false;
    }

    // ph-1-us-8/ph-1-us-11: server-owned records under users/{uid} — written only by Cloud
    // Functions via the Admin SDK (which bypasses these rules entirely), read-only to the
    // owning client. The old `users/{uid}/{document=**}` wildcard let a signed-in user write
    // anything under their own uid; since Firestore rules are OR'd, a more specific deny rule
    // could not have tightened that, so it had to be replaced with these explicit paths instead.
    match /users/{uid}/testAssignments/{testId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/testAttempts/{testId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
    match /users/{uid}/baseline/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // ph-2-us-11: Concept Progress, one doc per handbook topic — the first client-writable
    // collection under users/{uid}. The client sets only `status` (the user's own choice,
    // ph-2-us-10) and `statusUpdatedAt`, which must be the server's time. The score fields
    // (latestMiniQuizScore, latestMiniQuizAt, latestTestId) are written only by scoreTest via
    // the Admin SDK, so a client can't forge a quiz score. `not-started` is never stored: it's
    // the absence of a doc. Delete is denied; account deletion goes through ph-9-us-9.
    match /users/{uid}/conceptProgress/{chunkId} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validStatus() {
        return request.resource.data.status in ['in-progress', 'reviewed', 'needs-revisit']
          && request.resource.data.statusUpdatedAt == request.time;
      }

      allow read: if isOwner();
      allow create: if isOwner()
        && request.resource.data.keys().hasOnly(['status', 'statusUpdatedAt'])
        && validStatus();
      allow update: if isOwner()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'statusUpdatedAt'])
        && validStatus();
      allow delete: if false;
    }

    // ph-1-us-9: topic catalog — holds no question content, so it's safe to expose to any
    // signed-in client. Populated only by the publish-topics script (Admin SDK).
    match /topics/{chunkId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else stays deny-all (ph-0-us-3's locked-by-default baseline). Later phases
    // that need a client-writable sub-collection under users/{uid} (driving sessions, test
    // outcomes, settings) add an explicit `match` block here, as `conceptProgress` does above,
    // rather than reopening the wildcard.
  }
}
